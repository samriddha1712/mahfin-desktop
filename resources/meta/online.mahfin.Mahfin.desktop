[Desktop Entry]
Version=1.0
Name=Mahfin
Comment=Mahfin desktop client
Exec=mahfin-desktop
Icon=online.mahfin.Mahfin
Terminal=false
Type=Application
StartupWMClass=online.mahfin.Mahfin
Categories=AudioVideo;Video;Player;TV;

Actions=DesktopF;DesktopW;TVF;TVW

[Desktop Action DesktopF]
Name=Desktop [Fullscreen]
Exec=mahfin-desktop --fullscreen --desktop

[Desktop Action DesktopW]
Name=Desktop [Windowed]
Exec=mahfin-desktop --windowed --desktop

[Desktop Action TVF]
Name=TV [Fullscreen]
Exec=mahfin-desktop --fullscreen --tv

[Desktop Action TVW]
Name=TV [Windowed]
Exec=mahfin-desktop --windowed --tv
